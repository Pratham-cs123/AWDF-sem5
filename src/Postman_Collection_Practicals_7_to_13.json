      "item": [
        {
          "name": "1. Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pratham Patel\",\n  \"email\": \"pratham@charusat.edu.in\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "http://localhost:5000/auth/register"
          }
        },
        {
          "name": "2. Login User (Get JWT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pratham@charusat.edu.in\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "http://localhost:5000/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", res.token);",
                  "    pm.environment.set(\"jwt_token\", res.token);",
                  "    console.log(\"jwt_token automatically saved:\", res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Get Protected Tasks (Unauthorized 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:5000/tasks"
          }
        },
        {
          "name": "4. Get Protected Tasks (Authorized Bearer Token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:5000/tasks"
          }
        }
      ]
